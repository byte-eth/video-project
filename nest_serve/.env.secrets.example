# 复制本文件为同目录下的 .env.secrets 后填写真实值。
# .env.secrets 已在 .gitignore 中，不会被提交。
#
# 与 .env 同时生效：同名变量以 .env.secrets 为准（后加载覆盖）。

# JWT（务必使用强随机串）
# JWT_SECRET=
# JWT_REFRESH_SECRET=

# 数据库密码等敏感项
# DB_PASSWORD=

# 163 邮箱 SMTP（「客户端授权密码」，非网页登录密码）
# SMTP_HOST=smtp.163.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@163.com
# SMTP_PASS=
# SMTP_FROM="Nest <your_email@163.com>"

# 可选：找回密码验证码 HMAC 盐；不填则回退到 JWT_SECRET
# RESET_CODE_PEPPER=

# 七牛云密钥（务必放到 .env.secrets）
# QINIU_ACCESS_KEY=
# QINIU_SECRET_KEY=
