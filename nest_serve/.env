DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_NAME=nest_admin
PORT=3006
JWT_EXPIRES_IN=1h

JWT_REFRESH_EXPIRES_IN=7d
INTERNAL_API_KEY=change-me-internal-only
NODE_ENV=development

# 反代后取真实客户端 IP（设为 1 或 true）
TRUST_PROXY=1

# 全局限流：单 IP 在时间窗口内最大请求数（内部 /internal/* 不计入）
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300

# 敏感接口限流（按路径单独计数，与全局限流叠加）
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_FORGOT_SEND_WINDOW_MS=3600000
RATE_LIMIT_FORGOT_SEND_MAX=8
RATE_LIMIT_FORGOT_RESET_WINDOW_MS=3600000
RATE_LIMIT_FORGOT_RESET_MAX=20
RATE_LIMIT_REFRESH_WINDOW_MS=900000
RATE_LIMIT_REFRESH_MAX=60

# 防重复提交：相同指纹在时间窗口内视为重复（毫秒）；0=关闭。默认 500ms，仅防连点
DEDUPE_WINDOW_MS=500

# 登录风控：同一 IP 连续失败次数与封禁时长（毫秒）
LOGIN_FAIL_MAX_PER_IP=8
LOGIN_FAIL_BLOCK_MS=900000

# 七牛云上传
QINIU_BUCKET=web03
QINIU_UPLOAD_HOST=https://up-z2.qiniup.com
QINIU_CDN_DOMAIN=http://td45y5zn3.hn-bkt.clouddn.com
QINIU_PRIVATE_BUCKET=true
QINIU_PRIVATE_URL_EXPIRES=3600
QINIU_MAX_FILE_SIZE=104857600